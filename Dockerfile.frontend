# syntax=docker/dockerfile:1.7
#
# Builderforce.ai frontend — Next.js dev/build container.
#
# Studio + SDK are NOT baked into this image. docker-compose mounts them via
# bind-mounts on the host source + named volumes for the watcher-produced
# dist/ output. That gives true hot-reload: edit studio/src on the host →
# tsup-watch rebuilds → Next.js HMR picks up.
#
# Two targets:
#   - dev         (default) Next.js dev server with HMR
#   - production  `next build` + `next start`
#
# The pnpm install at deps stage installs frontend's regular deps plus
# the `link:../studio` and `link:../sdk` placeholders. Actual content is
# bind-mounted at runtime by docker-compose.

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
# Stub package.json for EVERY `link:` target in frontend/package.json so pnpm
# install succeeds before the real source is bind-mounted. Stubs are replaced at
# runtime by the host bind mounts docker-compose provides. Keep this list in sync
# with the `link:` specifiers in frontend/package.json — a target with no stub
# fails the install outright. Package names are not derivable from the directory
# (builderforce-embedded publishes as @seanhogg/builderforce-embedded), so each
# entry is an explicit dir=name pair.
RUN set -eu; \
    for pair in \
      "sdk=@seanhogg/builderforce-sdk" \
      "studio=@seanhogg/builderforce-studio" \
      "studio-embedded=@seanhogg/builderforce-studio-embedded" \
      "brain-embedded=@seanhogg/builderforce-brain-embedded" \
      "packages/brain-ui=@seanhogg/builderforce-brain-ui" \
      "builderforce-embedded=@seanhogg/builderforce-embedded" \
      "voice=@seanhogg/builderforce-voice" \
    ; do \
      dir="/repo/${pair%%=*}"; name="${pair#*=}"; \
      mkdir -p "$dir"; \
      printf '{"name":"%s","version":"0.0.0","main":"dist/index.cjs","module":"dist/index.mjs","types":"dist/index.d.ts"}' "$name" > "$dir/package.json"; \
    done
# frontend's postinstall is `node ../scripts/ensure-linked-deps.mjs`; without the
# script on disk the install dies with MODULE_NOT_FOUND before it can finish.
COPY scripts/ /repo/scripts/
# frontend/tsconfig.json maps @builderforce/creation-canvas-contract to
# ../packages/creation-canvas-contract/src — a path alias, not an npm dependency,
# so nothing installs it. CreationCanvas.tsx imports it, and without the source
# every route reaching that component fails to compile with "Module not found".
# In the deps stage so both the dev and production targets inherit it.
COPY packages/creation-canvas-contract /repo/packages/creation-canvas-contract
WORKDIR /repo/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN corepack enable && corepack prepare pnpm@10.23.0 --activate
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile || pnpm install

FROM deps AS dev
WORKDIR /repo/frontend
COPY frontend/ ./
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 3000
# No `--` separator: pnpm 10 forwards it verbatim, so `next dev` sees it as a
# positional and reads the NEXT argument as the project directory — "Invalid
# project directory provided, no such directory: /repo/frontend/--hostname".
CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]

FROM deps AS production
WORKDIR /repo/frontend
COPY frontend/ ./
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm exec next build
EXPOSE 3000
# Same `--` trap as the dev stage above.
CMD ["pnpm", "exec", "next", "start", "--hostname", "0.0.0.0"]
