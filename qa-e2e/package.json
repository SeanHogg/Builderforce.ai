{
  "name": "@builderforce/qa-e2e",
  "version": "2026.6.29",
  "private": true,
  "description": "Agentic QA — Playwright harness that pulls AI-generated specs, runs them authenticated, and reports results back to the API.",
  "type": "module",
  "scripts": {
    "pull": "tsx src/pull-tests.ts",
    "test": "playwright test",
    "report": "tsx src/report.ts",
    "ci": "tsx src/pull-tests.ts && (playwright test; true) && tsx src/report.ts",
    "explore": "tsx src/explore.ts",
    "canvas:release": "playwright test tests/creation-canvas*.spec.ts",
    "canvas:capacity": "tsx src/canvas-capacity.ts",
    "canvas:audit": "tsx src/canvas-release-audit.ts",
    "type-check": "tsc --noEmit",
    "typecheck:native": "tsgo --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
