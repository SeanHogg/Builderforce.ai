+  // The Visualization panel — the SECOND editor column. The chat keeps the left
+  // column it is already in and the canvas gets a right-hand panel beside it, so
+  // the two are read at once instead of traded against each other in one tab.
+  //
+  // It is a PANEL, not a sidebar view: it needs real estate, and the split is the
+  // whole point of it. `ViewColumn.Beside` therefore opens it NEXT TO whatever is
+  // focused, which is the chat when the command is run from a chat turn.
+  //
+  // `retainContextWhenHidden` matches every other bundled-React surface here (see
+  // `WebviewPanelBase`): the code-change tree is fed live by the run, and losing it
+  // because the user tabbed back to the chat would defeat the reason for the split.
+  // The panel is created through `renderWebviewHtml` — the SAME shell the board,
+  // Project 360 and the project pages boot — so the bundle, its CSP and its asset
+  // wiring are identical; only the `<title>` differs.
+  context.subscriptions.push(
+    vscode.commands.registerCommand("builderforce.openVisualization", () => {
+      const panel = vscode.window.createWebviewPanel(
+        "builderforce.visualization",
+        "BuilderForce Visualization",
+        vscode.ViewColumn.Beside,
+        {
+          enableScripts: true,
+          retainContextWhenHidden: true,
+          localResourceRoots: [vscode.Uri.joinPath(context.extensionUri, "media")],
+        },
+      );
+      panel.iconPath = vscode.Uri.joinPath(context.extensionUri, "media", "icon.png");
+      panel.webview.html = renderWebviewHtml(panel.webview, context, { title: "BuilderForce Visualization" });
+      // The panel is disposable on its own; registering it keeps it out of the leak
+      // the extension context would otherwise inherit when the host tears down.
+      context.subscriptions.push(panel);
+      return panel;
+    }),
+  );
