{
  "name": "builderforce-api",
  "version": "2026.10.94",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "db:bootstrap": "node scripts/bootstrap-db.mjs && node scripts/migrate.mjs --transactional",
    "db:migrate": "node scripts/migrate.mjs && node scripts/migrate.mjs --transactional && node scripts/migrate.mjs --apps",
    "db:copy-run-telemetry": "node scripts/copy-run-telemetry.mjs",
    "deploy": "npm run db:migrate && npm run deploy:worker",
    "deploy:worker": "wrangler deploy",
    "secrets:from-env": "node scripts/set-secrets-from-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "type-check": "tsc --noEmit",
    "check:source-package-graph": "node ../scripts/check-source-package-graph.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "check:db-access": "node scripts/check-db-access.mjs",
    "check:sites-worker-graph": "node scripts/check-sites-worker-graph.mjs",
    "deploy:sites": "wrangler deploy --config wrangler.sites.toml",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:swept-tables": "node scripts/check-swept-tables.mjs",
    "check:usage-counts": "node scripts/check-usage-counts.mjs",
    "check:signature-duplication": "node scripts/check-signature-duplication.mjs",
    "check:shape-lint": "node scripts/check-shape-lint.mjs",
    "check:conflict-targets": "node scripts/check-conflict-targets.mjs",
    "check:tenant-column": "node scripts/check-tenant-column.mjs",
    "check:polymorphic-fk": "node scripts/check-polymorphic-fk.mjs",
    "check:domain-boundary": "node scripts/check-domain-boundary.mjs",
    "check:domain-root-table": "node scripts/check-domain-root-table.mjs",
    "check:model-coverage": "node scripts/check-model-coverage.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:application-layering": "node scripts/check-application-layering.mjs",
    "check:api-contract-mirror": "node scripts/check-api-contract-mirror.mjs",
    "check:project-ownership": "node scripts/check-project-ownership.mjs",
    "check:tenant-scope": "node scripts/check-tenant-scope.mjs",
    "check:execution-landing": "node scripts/check-execution-landing.mjs",
    "check:source": "node scripts/check-source-text.mjs",
    "check:silent-catches": "node ../scripts/check-silent-catches.mjs",
    "check:unvalidated-bodies": "node scripts/check-unvalidated-bodies.mjs",
    "check:dispatch-budget": "node scripts/check-dispatch-budget.mjs",
    "check:pinned-defects": "node scripts/check-pinned-defects.mjs",
    "check:prompt-tools": "node scripts/check-prompt-tool-names.mjs",
    "check:canvas-tools": "node scripts/check-canvas-tool-contract.mjs",
    "check:no-burnrate-runtime": "node scripts/check-no-burnrate-runtime.mjs",
    "check:burnrate-policy": "node scripts/check-burnrate-cutover-policy.mjs",
    "audit:burnrate-cutover": "node scripts/audit-burnrate-cutover.mjs",
    "audit:burnrate-cutover:validate": "node scripts/audit-burnrate-cutover.mjs --validate-only",
    "audit:burnrate-tenancy": "node scripts/audit-burnrate-tenancy.mjs",
    "audit:burnrate-tenancy:validate": "node scripts/audit-burnrate-tenancy.mjs --validate-only",
    "check": "node ../scripts/run-checks.mjs scripts/checks.manifest.mjs",
    "pretest": "npm run check",
    "test": "node scripts/vitest-run.mjs",
    "qa:cloud-agents": "vitest run src/application/runtime/cloudRunReconstruction.test.ts src/application/runtime/cloudLoopControl.test.ts src/application/runtime/cloudTelemetry.test.ts src/application/runtime/cloudRunLedger.test.ts src/application/runtime/cloudAgentEngine.test.ts src/application/llm/cloudByoPolicy.test.ts",
    "check:table-adoption": "node scripts/check-table-adoption.mjs",
    "models:refresh": "node scripts/refresh-model-snapshot.mjs",
    "models:check": "node scripts/refresh-model-snapshot.mjs --check",
    "backfill:byo-usage": "node scripts/backfill-byo-usage.mjs",
    "check:burnrate-parity": "node scripts/check-burnrate-parity.mjs",
    "gen:container-shared": "node scripts/gen-container-shared.mjs",
    "check:container-shared": "node scripts/gen-container-shared.mjs --check",
    "gen:sandbox-core": "node scripts/gen-sandbox-core-source.mjs",
    "check:sandbox-core": "node scripts/gen-sandbox-core-source.mjs --check"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@neondatabase/serverless": "^0.10.4",
    "@seanhogg/builderforce-memory": "^2026.10.35",
    "@seanhogg/builderforce-memory-engine": "^2026.10.28",
    "@seanhogg/builderforce-quality": "^2026.8.0",
    "@seanhogg/builderforce-webcontainers": "^2026.10.12",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.2",
    "hono": "^4.13.14",
    "lib0": "^0.2.119",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "unpdf": "^1.9.1",
    "y-protocols": "^1.0.6",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "drizzle-kit": "0.31.11",
    "fake-indexeddb": "^6.2.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.0.18",
    "wrangler": "^4.153.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "esbuild": "^0.28.2",
      "@jridgewell/sourcemap-codec": "^1.6.0"
    }
  }
}
