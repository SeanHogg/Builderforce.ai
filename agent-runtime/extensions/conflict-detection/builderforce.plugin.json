{
  "id": "conflict-detection",
  "name": "Conflict Detection",
  "description": "Detects priority conflicts and generates alerts for the priority register",
  "version": "1.0.0",
  "schema": {
    "type": "object",
    "properties": {
      "enabledRules": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["p0-team-review-window"]
      },
      "alertRetentionDays": {
        "type": "number",
        "default": 90
      }
    }
  }
}
