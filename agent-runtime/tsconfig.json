{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    // NOT `declaration` here: this config is `noEmit`, and declaration+outDir made TS
    // infer a rootDir of `agent-runtime/`, so every cross-package source import
    // (`@builderforce/agent-tools`, `@builderforce/tui`, `@builderforce/agent-stall`)
    // raised TS6059 "not under rootDir" on a typecheck that emits nothing. The real
    // declaration build is `tsconfig.plugin-sdk.dts.json`, which sets its own
    // `declaration`/`rootDir`/`outDir` and is unaffected.
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ScriptHost"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "paths": {
      "@builderforce/workspace-mcp": ["../packages/workspace-mcp/src/index.ts"],
      "@seanhogg/builderforce-code-index": ["../packages/code-index/src/index.ts"],
      "@builderforce/agent-tools/node-tree-sitter": ["../packages/agent-tools/src/node-tree-sitter.ts"],
      "@builderforce/agent-tools/node-git-ignore": ["../packages/agent-tools/src/node-git-ignore.ts"],
      "@builderforce/agent-tools/knowledge": ["../packages/agent-tools/src/knowledge/index.ts"],
      "@builderforce/agent-tools/node-git-history": ["../packages/agent-tools/src/node-git-history.ts"],
      "@builderforce/agent-tools/node-path": ["../packages/agent-tools/src/node-path.ts"],
      // Exact entries: the ONE coding provider (`createRepoCapabilities`) and its Node adapter, imported extensionless (NodeNext does not probe `.ts` through the `/*` form).
      "@builderforce/agent-tools/workspace": ["../packages/agent-tools/src/workspace.ts"],
      "@builderforce/agent-tools/node-workspace": ["../packages/agent-tools/src/node-workspace.ts"],
      "@builderforce/agent-tools/node-index-layout": ["../packages/agent-tools/src/node-index-layout.ts"],
      "@builderforce/agent-tools/node-symbols": ["../packages/agent-tools/src/node-symbols.ts"],
      "@builderforce/agent-tools/node-watch-port": ["../packages/agent-tools/src/node-watch-port.ts"],
      "@builderforce/agent-tools/watch-port": ["../packages/agent-tools/src/watch-port.ts"],
      "@builderforce/agent-tools/workspace-conformance": ["../packages/agent-tools/src/workspaceConformance.test-util.ts"],
      "@builderforce/agent-tools/node-desktop": ["../packages/agent-tools/src/node-desktop.ts"],
      "@seanhogg/builderforce-mcp/protocol": ["../packages/builderforce-mcp/src/protocol.ts"],
      "@seanhogg/builderforce-mcp/config": ["../packages/builderforce-mcp/src/config.ts"],
      "@seanhogg/builderforce-mcp/server": ["../packages/builderforce-mcp/src/server.ts"],
      "@modelcontextprotocol/sdk/types.js": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/types.d.ts", "./node_modules/@modelcontextprotocol/sdk/dist/esm/types.js"],
      "@modelcontextprotocol/sdk/server/index.js": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/server/index.d.ts", "./node_modules/@modelcontextprotocol/sdk/dist/esm/server/index.js"],
      "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/server/webStandardStreamableHttp.d.ts", "./node_modules/@modelcontextprotocol/sdk/dist/esm/server/webStandardStreamableHttp.js"],
      "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/*"],
      "@seanhogg/builderforce-mcp": ["../packages/builderforce-mcp/src/index.ts"],
      "@seanhogg/builderforce-mcp/policy": ["../packages/builderforce-mcp/src/policy.ts"],
      "@builderforce/code-shield": ["../packages/code-shield/src/index.ts"],
      "@builderforce/sarif": ["../packages/sarif/src/index.ts"],
      "@seanhogg/builderforce-agents/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "@seanhogg/builderforce-agents/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "@seanhogg/builderforce-agents/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"],
      "@builderforce/agent-tools": ["../packages/agent-tools/src/index.ts"],
      "@builderforce/agent-tools/*": ["../packages/agent-tools/src/*"],
      // Exact entry: `packages/repo-map` imports `@builderforce/agent-tools/symbols` extensionless, and NodeNext does not probe `.ts` for a path-mapped target (the `/*` form above only serves imports that already end in `.js`).
      "@builderforce/agent-tools/symbols": ["../packages/agent-tools/src/symbols.ts"],
      // Exact entry: the glob matcher and `toPosixPath` are imported extensionless (same NodeNext rule as `symbols`).
      "@builderforce/agent-tools/glob": ["../packages/agent-tools/src/glob.ts"],
      // Exact entry (the ignore policy `packages/repo-map` imports): the subpath name is not the file name, so the `/*` form cannot serve it.
      "@builderforce/agent-tools/skip-dirs": ["../packages/agent-tools/src/skipDirs.ts"],
      "@builderforce/agent-run": ["../packages/agent-run/src/index.ts"],
      "@builderforce/difficulty-router": ["../packages/difficulty-router/src/index.ts"],
      "@builderforce/agent-loop": ["../packages/agent-loop/src/index.ts"],
      "@builderforce/agent-skills": ["../packages/agent-skills/src/index.ts"],
      "@builderforce/agent-stall": ["../packages/agent-stall/src/index.ts"],
      "@builderforce/learned-routing": ["../packages/learned-routing/src/index.ts"],
      "@builderforce/workload": ["../packages/workload/src/index.ts"],
      "@builderforce/pipeline-route": ["../packages/pipeline-route/src/index.ts"],
      "@builderforce/model-catalog": ["../packages/model-catalog/src/index.ts"],
      "@builderforce/json-schema": ["../packages/json-schema/src/index.ts"],
      "@builderforce/local-inference": ["../packages/local-inference/src/index.ts"],
      "@builderforce/model-router": ["../packages/model-router/src/index.ts"],
      "@builderforce/prefetch": ["../packages/prefetch/src/index.ts"],
      "@builderforce/repo-map": ["../packages/repo-map/src/index.ts"],
      "@builderforce/knowledge-client": ["../packages/knowledge-client/src/index.ts"],
      // The source-only packages compiled here (knowledge-client, agent-tools, prefetch, ...)
      // install nothing of their own, so every memory subpath they reach resolves from THIS
      // package's install: ONE wildcard (memory's layout is uniform, `dist/<sub>/index.d.ts`),
      // so a new subpath needs no entry. The guard holds it (scripts/check-source-package-graph.mjs, rule 9).
      "@seanhogg/builderforce-memory/*": ["./node_modules/@seanhogg/builderforce-memory/dist/*/index.d.ts"],
      // agent-tools' symbol extractor loads `web-tree-sitter` lazily; its install lives with
      // agent-tools (a declared dependency there), so the types resolve from it.
      "web-tree-sitter": ["../packages/agent-tools/node_modules/web-tree-sitter/tree-sitter-web.d.ts"],
      "@builderforce/run-policy": ["../packages/run-policy/src/index.ts"],
      "@builderforce/spend-contract": ["../packages/spend-contract/src/index.ts"],
      "@builderforce/run-context": ["../packages/run-context/src/index.ts"],
      "@builderforce/run-guards": ["../packages/run-guards/src/index.ts"],
      "@builderforce/cost-levers": ["../packages/cost-levers/src/index.ts"],
      "@builderforce/tool-output-policy": ["../packages/tool-output-policy/src/index.ts"],
      "@builderforce/secret-redaction": ["../packages/secret-redaction/src/index.ts"],
      "@builderforce/write-outbox/core": ["../packages/write-outbox/src/core.ts"],
      "@builderforce/tui": ["../packages/tui/src/index.ts"],
      "@builderforce/tui/*": ["../packages/tui/src/*"]
    }
  },
  "include": ["src/**/*", "ui/**/*", "extensions/**/*"],
  // Bundler + test-runner configs are build TOOLING, not application code: they import
  // repo scripts that ship no declarations (`scripts/sourcePackages.mjs`). The root
  // `vitest.config.ts` was already outside this program by virtue of living above
  // `src/`; the control UI's are inside `ui/**` and need saying so.
  "exclude": ["node_modules", "dist", "**/vite.config.ts", "**/vitest.*.config.ts", "**/vitest.config.ts"]
}
