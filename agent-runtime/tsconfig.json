{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    // NOT `declaration` here: this config is `noEmit`, and declaration+outDir made TS
    // infer a rootDir of `agent-runtime/`, so every cross-package source import
    // (`@builderforce/agent-tools`, `@builderforce/tui`, `@builderforce/agent-stall`)
    // raised TS6059 "not under rootDir" on a typecheck that emits nothing. The real
    // declaration build is `tsconfig.plugin-sdk.dts.json`, which sets its own
    // `declaration`/`rootDir`/`outDir` and is unaffected.
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ScriptHost"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "paths": {
      "@seanhogg/builderforce-agents/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "@seanhogg/builderforce-agents/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "@seanhogg/builderforce-agents/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"],
      "@builderforce/agent-tools": ["../packages/agent-tools/src/index.ts"],
      "@builderforce/agent-tools/*": ["../packages/agent-tools/src/*"],
      "@builderforce/agent-run": ["../packages/agent-run/src/index.ts"],
      "@builderforce/difficulty-router": ["../packages/difficulty-router/src/index.ts"],
      "@builderforce/agent-loop": ["../packages/agent-loop/src/index.ts"],
      "@builderforce/agent-skills": ["../packages/agent-skills/src/index.ts"],
      "@builderforce/agent-stall": ["../packages/agent-stall/src/index.ts"],
      "@builderforce/learned-routing": ["../packages/learned-routing/src/index.ts"],
      "@builderforce/workload": ["../packages/workload/src/index.ts"],
      "@builderforce/model-catalog": ["../packages/model-catalog/src/index.ts"],
      "@builderforce/local-inference": ["../packages/local-inference/src/index.ts"],
      "@builderforce/model-router": ["../packages/model-router/src/index.ts"],
      "@builderforce/prefetch": ["../packages/prefetch/src/index.ts"],
      "@builderforce/repo-map": ["../packages/repo-map/src/index.ts"],
      "@builderforce/knowledge-client": ["../packages/knowledge-client/src/index.ts"],
      // `@builderforce/knowledge-client` is source-only with memory as a PEER and no install
      // of its own (as in frontend/ and clients/*/tsconfig.json): the memory subpath it
      // reaches resolves from THIS package's install.
      "@seanhogg/builderforce-memory/knowledge": ["./node_modules/@seanhogg/builderforce-memory/dist/knowledge/index.d.ts"],
      "@builderforce/run-policy": ["../packages/run-policy/src/index.ts"],
      "@builderforce/run-context": ["../packages/run-context/src/index.ts"],
      "@builderforce/run-guards": ["../packages/run-guards/src/index.ts"],
      "@builderforce/cost-levers": ["../packages/cost-levers/src/index.ts"],
      "@builderforce/tool-output-policy": ["../packages/tool-output-policy/src/index.ts"],
      "@builderforce/write-outbox/core": ["../packages/write-outbox/src/core.ts"],
      "@builderforce/tui": ["../packages/tui/src/index.ts"],
      "@builderforce/tui/*": ["../packages/tui/src/*"]
    }
  },
  "include": ["src/**/*", "ui/**/*", "extensions/**/*"],
  // Bundler + test-runner configs are build TOOLING, not application code: they import
  // repo scripts that ship no declarations (`scripts/sourcePackages.mjs`). The root
  // `vitest.config.ts` was already outside this program by virtue of living above
  // `src/`; the control UI's are inside `ui/**` and need saying so.
  "exclude": ["node_modules", "dist", "**/vite.config.ts", "**/vitest.*.config.ts", "**/vitest.config.ts"]
}
