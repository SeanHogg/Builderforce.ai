// paths: this package imports sibling workspace packages by source. esbuild (wrangler,
// the VSIX and agent-runtime bundles) resolves a bare specifier through the NEAREST
// tsconfig to the importing file, so the mapping must live here, not only in each host's.
// `@seanhogg/builderforce-memory` is a BUILT package (a declared dependency): its own
// install comes first; without one, the sibling memory repo's dist — beside the main
// checkout (3 up) or beside a worktree under `.builderforce/worktrees/` (6 up).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@builderforce/agent-loop": ["../agent-loop/src/index.ts"],
      "@builderforce/agent-stall": ["../agent-stall/src/index.ts"],
      "@builderforce/agent-tools": ["../agent-tools/src/index.ts"],
      "@builderforce/cost-levers": ["../cost-levers/src/index.ts"],
      "@builderforce/difficulty-router": ["../difficulty-router/src/index.ts"],
      "@builderforce/model-catalog": ["../model-catalog/src/index.ts"],
      "@builderforce/run-guards": ["../run-guards/src/index.ts"],
      "@builderforce/run-policy": ["../run-policy/src/index.ts"],
      "@builderforce/tool-output-policy": ["../tool-output-policy/src/index.ts"],
      "@seanhogg/builderforce-memory/working": [
        "./node_modules/@seanhogg/builderforce-memory/dist/working/index.d.ts",
        "../../../builderforce-memory/packages/memory/dist/working/index.d.ts",
        "../../../../../../builderforce-memory/packages/memory/dist/working/index.d.ts"
      ],
      "@seanhogg/builderforce-memory/handoff": [
        "./node_modules/@seanhogg/builderforce-memory/dist/handoff/index.d.ts",
        "../../../builderforce-memory/packages/memory/dist/handoff/index.d.ts",
        "../../../../../../builderforce-memory/packages/memory/dist/handoff/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
