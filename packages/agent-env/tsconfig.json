// paths: this package imports sibling workspace packages by source (`@builderforce/agent-run` and its closure,
// `@builderforce/secret-redaction`); esbuild and tsc resolve a bare specifier through the NEAREST tsconfig to the
// importing file, so the mapping lives here as well as in each host's. The memory entries mirror agent-run's.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@builderforce/agent-run": ["../agent-run/src/index.ts"],
      "@builderforce/secret-redaction": ["../secret-redaction/src/index.ts"],
      "@builderforce/code-shield": ["../code-shield/src/index.ts"],
      "@builderforce/sarif": ["../sarif/src/index.ts"],
      "@builderforce/agent-loop": ["../agent-loop/src/index.ts"],
      "@builderforce/agent-stall": ["../agent-stall/src/index.ts"],
      "@builderforce/agent-tools": ["../agent-tools/src/index.ts"],
      "@builderforce/cost-levers": ["../cost-levers/src/index.ts"],
      "@builderforce/difficulty-router": ["../difficulty-router/src/index.ts"],
      "@builderforce/learned-routing": ["../learned-routing/src/index.ts"],
      "@builderforce/model-catalog": ["../model-catalog/src/index.ts"],
      "@builderforce/pipeline-route": ["../pipeline-route/src/index.ts"],
      "@builderforce/run-guards": ["../run-guards/src/index.ts"],
      "@builderforce/run-policy": ["../run-policy/src/index.ts"],
      "@builderforce/spend-contract": ["../spend-contract/src/index.ts"],
      "@builderforce/tool-output-policy": ["../tool-output-policy/src/index.ts"],
      "@builderforce/workload": ["../workload/src/index.ts"],
      "@seanhogg/builderforce-memory/*": [
        "./node_modules/@seanhogg/builderforce-memory/dist/*/index.d.ts",
        "../../../builderforce-memory/packages/memory/dist/*/index.d.ts",
        "../../../../../../builderforce-memory/packages/memory/dist/*/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
