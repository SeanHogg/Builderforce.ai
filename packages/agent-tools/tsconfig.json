{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@builderforce/code-shield": ["../code-shield/src/index.ts"],
      "@builderforce/secret-redaction": ["../secret-redaction/src/index.ts"],
      "@builderforce/sarif": ["../sarif/src/index.ts"],
      "@builderforce/tool-output-policy": ["../tool-output-policy/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
