{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      "@builderforce/agent-tools": ["../agent-tools/src/index.ts"],
      "@builderforce/agent-tools/knowledge-index": ["../agent-tools/src/knowledge-index.ts"],
      "@builderforce/agent-tools/prefetch": ["../agent-tools/src/prefetch/index.ts"],
      "@builderforce/prefetch": ["../prefetch/src/index.ts"],
      "@builderforce/agent-tools/knowledge": ["../agent-tools/src/knowledge/index.ts"],
      "@builderforce/knowledge-client": ["../knowledge-client/src/index.ts"],
      "@builderforce/knowledge-graph-view": ["../knowledge-graph-view/src/index.ts"],
      // Source-only: the peers live in the HOST's install, as `vitest.config.ts` resolves
      // them, so `tsc -p .` reads them from `frontend/node_modules` too (react and three
      // through their `@types/*`). Named one by one: no catch-all `*` for a source package.
      "@seanhogg/builderforce-memory/*": ["../../frontend/node_modules/@seanhogg/builderforce-memory/dist/*/index.d.ts"],
      "react": ["../../frontend/node_modules/@types/react"],
      "react/*": ["../../frontend/node_modules/@types/react/*"],
      "three": ["../../frontend/node_modules/@types/three"],
      "@react-three/fiber": ["../../frontend/node_modules/@react-three/fiber"],
      "@react-three/drei": ["../../frontend/node_modules/@react-three/drei"],
      "@testing-library/react": ["../../frontend/node_modules/@testing-library/react"],
      "vitest": ["../../frontend/node_modules/vitest"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
