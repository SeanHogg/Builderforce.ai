{
  "name": "@seanhogg/builderforce-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "Builderforce MCP contracts, tool policy, SDK transports, and platform relay",
  "exports": {
    ".": "./src/index.ts",
    "./policy": "./src/policy.ts",
    "./protocol": "./src/protocol.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./config": "./src/config.ts",
    "./stdio": "./src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "build": "tsc6 && node build.mjs",
    "prepack": "pnpm run build"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/types/builderforce-mcp/src/index.d.ts", "import": "./dist/index.js" },
      "./policy": { "types": "./dist/types/builderforce-mcp/src/policy.d.ts", "import": "./dist/policy.js" },
      "./protocol": { "types": "./dist/types/builderforce-mcp/src/protocol.d.ts", "import": "./dist/protocol.js" },
      "./server": { "types": "./dist/types/builderforce-mcp/src/server.d.ts", "import": "./dist/server.js" },
      "./client": { "types": "./dist/types/builderforce-mcp/src/client.d.ts", "import": "./dist/client.js" },
      "./config": { "types": "./dist/types/builderforce-mcp/src/config.d.ts", "import": "./dist/config.js" },
      "./stdio": { "types": "./dist/types/builderforce-mcp/src/stdio.d.ts", "import": "./dist/stdio.js" }
    }
  }
}
