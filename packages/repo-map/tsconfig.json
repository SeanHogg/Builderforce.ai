{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@builderforce/code-shield": ["../code-shield/src/index.ts"],
      "@builderforce/secret-redaction": ["../secret-redaction/src/index.ts"],
      "@builderforce/sarif": ["../sarif/src/index.ts"],
      "@builderforce/agent-tools/symbols": ["../agent-tools/src/symbols.ts"],
      "@builderforce/agent-tools/skip-dirs": ["../agent-tools/src/skipDirs.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
