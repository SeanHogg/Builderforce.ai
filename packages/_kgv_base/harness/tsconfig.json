{
  // The `/preview` harness, type-checked with the package's own settings and peer paths (`tsc -p harness`).
  // `vite.config.ts` is left out, as the package leaves out `vitest.config.ts`: it runs under Node, whose types this
  // source-only package does not load.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // `paths` in a child replaces the parent's wholesale and resolves from THIS file, so the package's set is restated one
    // directory deeper (`../../` reaches `packages/`, `../../../` the repo root). `scripts/check-source-package-graph.mjs` holds both in step.
    "paths": {
      "@seanhogg/builderforce-memory/*": ["../../../frontend/node_modules/@seanhogg/builderforce-memory/dist/*/index.d.ts"],
      "react": ["../../../frontend/node_modules/@types/react"],
      "react/*": ["../../../frontend/node_modules/@types/react/*"],
      "react-dom": ["../../../frontend/node_modules/@types/react-dom"],
      "react-dom/*": ["../../../frontend/node_modules/@types/react-dom/*"],
      "three": ["../../../frontend/node_modules/@types/three"],
      "@react-three/fiber": ["../../../frontend/node_modules/@react-three/fiber"],
      "@react-three/drei": ["../../../frontend/node_modules/@react-three/drei"],
      "@testing-library/react": ["../../../frontend/node_modules/@testing-library/react"],
      "vitest": ["../../../frontend/node_modules/vitest"],
      "@builderforce/knowledge-client/settledThrottle": ["../../knowledge-client/src/settledThrottle.ts"],
      "@builderforce/run-delta": ["../../run-delta/src/index.ts"],
      "@builderforce/code-shield": ["../../code-shield/src/index.ts"],
      "@builderforce/sarif": ["../../sarif/src/index.ts"],
      "@builderforce/run-delta/contract": ["../../run-delta/src/contract.ts"],
      "@builderforce/run-delta/predict": ["../../run-delta/src/predict/index.ts"],
      "@builderforce/secret-redaction": ["../../secret-redaction/src/index.ts"],
      "@builderforce/agent-tools/code-mask": ["../../agent-tools/src/knowledge/codeMask.ts"],
      "@builderforce/agent-tools/sampling": ["../../agent-tools/src/sampling.ts"],
      "@builderforce/agent-tools/glob": ["../../agent-tools/src/glob.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["vite.config.ts", "../node_modules", "../dist"]
}
