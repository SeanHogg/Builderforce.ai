// paths: this package imports `@builderforce/agent-tools/code-mask` and
// `@builderforce/secret-redaction` by source. esbuild (wrangler, the VSIX and
// brain-embedded bundles) resolves a bare specifier through the NEAREST tsconfig to the
// importing file, so the mapping must live here, not only in each host's.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@builderforce/agent-tools/code-mask": ["../agent-tools/src/knowledge/codeMask.ts"],
      "@builderforce/agent-tools/sampling": ["../agent-tools/src/sampling.ts"],
      "@builderforce/agent-tools/glob": ["../agent-tools/src/glob.ts"],
      "@builderforce/secret-redaction": ["../secret-redaction/src/index.ts"],
      "@builderforce/sarif": ["../sarif/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
