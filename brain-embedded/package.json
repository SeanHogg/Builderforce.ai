{
  "name": "@seanhogg/builderforce-brain-embedded",
  "version": "2026.10.67",
  "description": "Embeddable AI assistant ('Brain') for React — headless streaming chat core with an MCP-style action registry. Drop a BrainProvider into any React app, register tools the assistant can call, and stream tool-capable chat completions through the Builderforce gateway. Auth, persistence, and system prompts are injected, so the same core powers builderforce.ai and external embeds.",
  "license": "MIT",
  "author": "Sean Hogg",
  "homepage": "https://github.com/SeanHogg/Builderforce.ai/tree/main/brain-embedded#readme",
  "bugs": {
    "url": "https://github.com/SeanHogg/Builderforce.ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeanHogg/Builderforce.ai.git",
    "directory": "brain-embedded"
  },
  "keywords": [
    "builderforce",
    "ai-assistant",
    "chat",
    "streaming",
    "tool-calling",
    "mcp",
    "react",
    "embeddable",
    "sdk"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./chatError": {
      "types": "./dist/chatError.d.ts",
      "import": "./dist/chatError.mjs",
      "require": "./dist/chatError.cjs"
    },
    "./bfi": {
      "types": "./dist/bfi.d.ts",
      "import": "./dist/bfi.mjs",
      "require": "./dist/bfi.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node ../scripts/ensure-linked-deps.mjs",
    "build": "tsup --config tsup.config.ts",
    "type-check": "tsgo --noEmit && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck:native": "tsgo --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "@seanhogg/builderforce-memory": "^2026.10.28",
    "@seanhogg/builderforce-memory-engine": "^2026.10.28"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^28.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.3",
    "@builderforce/agent-loop": "link:../packages/agent-loop",
    "@builderforce/agent-skills": "link:../packages/agent-skills",
    "@builderforce/agent-stall": "link:../packages/agent-stall",
    "@builderforce/spend-contract": "link:../packages/spend-contract",
    "@builderforce/agent-tools": "link:../packages/agent-tools",
    "@builderforce/cost-levers": "link:../packages/cost-levers",
    "@builderforce/difficulty-router": "link:../packages/difficulty-router",
    "@builderforce/learned-routing": "link:../packages/learned-routing",
    "@builderforce/local-inference": "link:../packages/local-inference",
    "@builderforce/local-first": "link:../packages/local-first",
    "@builderforce/model-catalog": "link:../packages/model-catalog",
    "@builderforce/pipeline-route": "link:../packages/pipeline-route",
    "@builderforce/run-guards": "link:../packages/run-guards",
    "@builderforce/run-policy": "link:../packages/run-policy",
    "@builderforce/tool-output-policy": "link:../packages/tool-output-policy",
    "@builderforce/workload": "link:../packages/workload",
    "@builderforce/write-outbox": "link:../packages/write-outbox",
    "@seanhogg/bfi-web": "link:../packages/bfi-web"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2"
    }
  }
}
