# Cloudflare Workers static-asset headers.
#
# `next.config.js` headers() are honoured by `next dev`, but @cloudflare/next-on-pages
# does NOT reliably emit them for the deployed worker/assets. Without these the
# Canvas Builder document is not cross-origin isolated, so `self.crossOriginIsolated` is
# false, SharedArrayBuffer can't be transferred to the WebContainer worker, and
# clicking Run fails with:
#   DataCloneError: SharedArrayBuffer transfer requires self.crossOriginIsolated
#   Error: Unable to create more instances   (failed boot, then retried)
#
# COOP=same-origin + COEP=credentialless enables cross-origin isolation while
# still allowing cross-origin fonts/images to load without CORP headers.
# Keep this in sync with next.config.js headers().
#
# NOTE: this file (and next.config headers()) only reliably cover STATIC /
# prerendered routes under next-on-pages. Dynamically-rendered Canvas routes are
# SSR, so _headers does not apply to them — their COOP/COEP are set
# in src/middleware.ts (withCoi). Keep all three in sync.
#
# HSTS is here as well as in src/middleware.ts because prerendered pages are
# answered by the assets layer without running the Worker (`run_worker_first`
# covers only `/`), so the middleware cannot redirect their first plain-HTTP visit.
# A page served over HTTP is not a secure context and has no crypto.randomUUID —
# see src/lib/secureTransport.ts. No `preload`: that is a separate, one-way submission.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The service worker script must always be revalidated against the network so a
# new deploy's stamped BUILD_VERSION is picked up promptly. Caching /sw.js (even
# briefly at the CDN edge) delays the update toast. no-cache = store but always
# revalidate; combined with updateViaCache:'none' in PwaUpdateBanner.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

# The message catalogs (scripts/publish-message-catalogs.mjs). They used to be
# hashed JS chunks and cached forever; as assets they need the same treatment, or
# every non-English visitor revalidates ~1 MB of JSON on each navigation and each
# cold server isolate. Safe because `catalogUrl()` versions the URL with
# NEXT_PUBLIC_APP_VERSION, so a deploy asks for a different path.
/i18n/*
  Cache-Control: public, max-age=31536000, immutable

# Translated blog bodies (scripts/publish-blog-translations.mjs). Same contract as
# the catalogs: `blogBodyUrl()` versions the URL with NEXT_PUBLIC_APP_VERSION.
/blog-i18n/*
  Cache-Control: public, max-age=31536000, immutable
