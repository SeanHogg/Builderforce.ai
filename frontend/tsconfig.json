{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@builderforce/creation-canvas-contract": ["../packages/creation-canvas-contract/src/index.ts"],
      "@builderforce/creation-canvas-contract/objectKinds": ["../packages/creation-canvas-contract/src/objectKinds.ts"],
      "@builderforce/creation-canvas-contract/creativeCapabilities": ["../packages/creation-canvas-contract/src/creativeCapabilities.ts"],
      "@builderforce/interaction-contract": ["../packages/interaction-contract/src/index.ts"],
      "@builderforce/canvas-widget-protocol": ["../packages/canvas-widget-protocol/src/index.ts"],
      "@builderforce/ide-templates": ["../packages/ide-templates/src/index.ts"],
      "@builderforce/ide-file-contract": ["../packages/ide-file-contract/src/index.ts"],
      "@builderforce/agent-loop": ["../packages/agent-loop/src/index.ts"],

      "@builderforce/agent-skills": ["../packages/agent-skills/src/index.ts"],
      "@builderforce/agent-tools/symbols": ["../packages/agent-tools/src/symbols.ts"],
      "@builderforce/agent-tools/knowledge": ["../packages/agent-tools/src/knowledge/index.ts"],
      "@builderforce/knowledge-graph-view": ["../packages/knowledge-graph-view/src/index.ts"],
      "@builderforce/knowledge-graph-view/tokens.css": ["../packages/knowledge-graph-view/src/tokens.css"],
      "@builderforce/knowledge-browser": ["../packages/knowledge-browser/src/index.ts"],
      "@builderforce/agent-tools/knowledge-index": ["../packages/agent-tools/src/knowledge-index.ts"],
      "@builderforce/agent-tools/prefetch": ["../packages/agent-tools/src/prefetch/index.ts"],
      "@builderforce/prefetch": ["../packages/prefetch/src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "three": ["./node_modules/@types/three"],
      "@react-three/fiber": ["./node_modules/@react-three/fiber"],
      "@react-three/drei": ["./node_modules/@react-three/drei"],
      "@seanhogg/builderforce-memory/knowledge": ["./node_modules/@seanhogg/builderforce-memory/dist/knowledge/index.d.ts"],
      "@seanhogg/builderforce-memory/ingest": ["./node_modules/@seanhogg/builderforce-memory/dist/ingest/index.d.ts"],
      "@builderforce/write-outbox": ["../packages/write-outbox/src/index.ts"],
      "@builderforce/local-first": ["../packages/local-first/src/index.ts"],
      "@builderforce/local-first/indexed-db": ["../packages/local-first/src/indexedDb.ts"],
      "@builderforce/model-catalog": ["../packages/model-catalog/src/index.ts"],
      "@builderforce/provider-connect": ["../packages/provider-connect/src/index.ts"],
      "@builderforce/local-inference": ["../packages/local-inference/src/index.ts"],
      "@builderforce/run-policy": ["../packages/run-policy/src/index.ts"],
      "@builderforce/agent-stall": ["../packages/agent-stall/src/index.ts"],
      "@builderforce/spend-contract": ["../packages/spend-contract/src/index.ts"],
      "@builderforce/agent-tools": ["../packages/agent-tools/src/index.ts"],
      "@builderforce/knowledge-client": ["../packages/knowledge-client/src/index.ts"]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
