# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts
*.tsbuildinfo

# ONNX runtime published by scripts/copy-ort-runtime.mjs (prebuild) for the
# VS Code canvas. Generated from the pinned dependency — never committed.
/public/ort/

# next-intl catalogs published by scripts/publish-message-catalogs.mjs (prebuild).
# Minified copies of src/i18n/messages/ — that directory is the source of truth.
/public/i18n/

# Blog bodies (every locale), published by
# scripts/publish-blog-content.mjs (dev + prebuild). The post index it also
# writes (src/lib/blogIndex.generated.json) is committed — see that script.
# src/content/blog/ is the source of truth.
/public/blog-i18n/
