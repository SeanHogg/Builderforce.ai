{
  "name": "builderforce-frontend",
  "version": "2026.8.71",
  "private": true,
  "scripts": {
    "postinstall": "node ../scripts/ensure-linked-deps.mjs",
    "clean": "node -e \"const fs=require('fs');const p='.next';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true});console.log('Removed .next');}else{console.log('.next not found');}\"",
    "dev": "node scripts/publish-message-catalogs.mjs && next dev --turbopack",
    "prebuild": "node scripts/copy-ort-runtime.mjs && node scripts/publish-message-catalogs.mjs && node scripts/gen-blog-og.mjs",
    "build": "next build",
    "cf-build": "pnpm exec next-on-pages && echo '_worker.js' > .vercel/output/static/.assetsignore && node scripts/strip-worker-assets.js && node scripts/stamp-sw-version.js && node scripts/patch-worker-fetch.mjs && node scripts/check-worker-size.mjs",
    "check:worker-size": "node scripts/check-worker-size.mjs",
    "gen:brand-paths": "node scripts/gen-brand-paths.mjs",
    "cf-deploy": "npm run cf-build && npx wrangler deploy --no-bundle",
    "start": "next start",
    "lint": "eslint .",
    "check:api-transport": "node scripts/check-api-transport.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "check:edge-runtime": "node scripts/check-edge-runtime.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:route-exports": "node scripts/check-route-exports.mjs",
    "check:declared-deps": "node scripts/check-declared-deps.mjs",
    "check": "node ../scripts/run-checks.mjs scripts/checks.manifest.mjs",
    "test": "npm run check && node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs",
    "typecheck:native": "tsgo --noEmit",
    "type-check": "node ../scripts/run-checks.mjs scripts/typecheck.manifest.mjs",
    "check:design-scale": "node scripts/check-design-scale.mjs",
    "check:destinations": "node scripts/check-destinations.mjs",
    "check:methodology": "node scripts/check-methodology.mjs",
    "check:primitives": "node scripts/check-primitive-duplication.mjs",
    "check:react-hooks": "node scripts/check-react-hooks-ratchet.mjs --changed"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "@seanhogg/builderforce-brain-embedded": "link:../brain-embedded",
    "@seanhogg/builderforce-brain-ui": "link:../packages/brain-ui",
    "@seanhogg/builderforce-embedded": "link:../builderforce-embedded",
    "@seanhogg/builderforce-memory": "^2026.7.11",
    "@seanhogg/builderforce-memory-engine": "^2026.7.14",
    "@seanhogg/builderforce-quality": "^2026.7.5",
    "@seanhogg/builderforce-sdk": "link:../sdk",
    "@seanhogg/builderforce-studio": "link:../studio",
    "@seanhogg/builderforce-studio-embedded": "link:../studio-embedded",
    "@seanhogg/builderforce-voice": "link:../voice",
    "@webcontainer/api": "^1.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.3.0",
    "@xyflow/react": "^12.3.5",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "isomorphic-git": "^1.38.3",
    "katex": "^0.16.47",
    "lib0": "^0.2.94",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "mp4-muxer": "^5.2.2",
    "next": "15.5.2",
    "next-intl": "^4.13.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1",
    "y-monaco": "^0.1.4",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.3",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@typescript/native-preview": "7.0.0-dev.20260627.2",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.0.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "sharp": "0.35.3",
    "simple-icons": "^16.18.1",
    "typescript": "^6.0.3",
    "vercel": "^47.1.4",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "d3-array": "^3.2.4",
      "d3-shape": "^3.2.0",
      "d3-path": "^3.1.0",
      "sharp": "0.35.3"
    }
  }
}
