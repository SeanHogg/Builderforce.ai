{
  "name": "@webdit/runtime",
  "version": "0.0.1",
  "private": true,
  "description": "Browser-side runtime for WebDiT bundles. Adds .video.generate() to a WebLLM MLCEngine.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@webdit/shared": "file:../shared",
    "@webdit/torch": "file:../torch",
    "onnxruntime-web": "^1.21.0"
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "^0.2.0",
    "@webdit/convert": "file:../converter",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "esbuild": "^0.28.2"
    }
  }
}
