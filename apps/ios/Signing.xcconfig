// Default signing values for shared/repo builds (app + share extension).
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored),
// written by agent-runtime/scripts/ios-configure-signing.sh.
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).
// The same BUILDERFORCE_* set is defined in Config/Signing.xcconfig (watch targets).

BUILDERFORCE_CODE_SIGN_STYLE = Manual
BUILDERFORCE_DEVELOPMENT_TEAM = Y5PE65HELJ

BUILDERFORCE_APP_BUNDLE_ID = ai.builderforce.ios
BUILDERFORCE_SHARE_BUNDLE_ID = ai.builderforce.ios.share
BUILDERFORCE_WATCH_APP_BUNDLE_ID = ai.builderforce.ios.watchkitapp
BUILDERFORCE_WATCH_EXTENSION_BUNDLE_ID = ai.builderforce.ios.watchkitapp.extension

BUILDERFORCE_APP_PROFILE = ai.builderforce.ios Development
BUILDERFORCE_SHARE_PROFILE = ai.builderforce.ios.share Development

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
