// Shared iOS signing defaults for local development + CI (watch app + watch extension).
// The same BUILDERFORCE_* set is defined in ../Signing.xcconfig (app + share extension).
BUILDERFORCE_CODE_SIGN_STYLE = Automatic
BUILDERFORCE_DEVELOPMENT_TEAM = Y5PE65HELJ

BUILDERFORCE_APP_BUNDLE_ID = ai.builderforce.ios
BUILDERFORCE_SHARE_BUNDLE_ID = ai.builderforce.ios.share
BUILDERFORCE_WATCH_APP_BUNDLE_ID = ai.builderforce.ios.watchkitapp
BUILDERFORCE_WATCH_EXTENSION_BUNDLE_ID = ai.builderforce.ios.watchkitapp.extension

// Leave empty: Xcode manages provisioning for the watch targets.
BUILDERFORCE_APP_PROFILE =
BUILDERFORCE_SHARE_PROFILE =

// Local contributors can override this by running agent-runtime/scripts/ios-configure-signing.sh.
// Keep include after defaults: xcconfig is evaluated top-to-bottom.
#include? "../.local-signing.xcconfig"
#include? "../LocalSigning.xcconfig"

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = $(BUILDERFORCE_DEVELOPMENT_TEAM)

// Let Xcode manage provisioning for the selected local team.
PROVISIONING_PROFILE_SPECIFIER =
