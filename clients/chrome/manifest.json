{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Rovr",
  "description": "__MSG_extDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-64.png",
    "32": "icons/icon-64.png",
    "48": "icons/icon-64.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-64.png",
      "32": "icons/icon-64.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://builderforce.ai/*",
    "https://api.builderforce.ai/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_commandOpen__"
    }
  }
}
