{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "paths": {
      "@builderforce/agent-tools": ["../../packages/agent-tools/src/index.ts"],
      "@builderforce/device-auth": ["../../packages/device-auth/src/index.ts"],
      "@builderforce/local-inference": ["../../packages/local-inference/src/index.ts"],
      "@builderforce/model-catalog": ["../../packages/model-catalog/src/index.ts"],
      "@builderforce/provider-connect": ["../../packages/provider-connect/src/index.ts"],
      "@builderforce/write-outbox": ["../../packages/write-outbox/src/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
