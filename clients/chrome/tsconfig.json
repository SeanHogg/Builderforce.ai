{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "paths": {
      "@builderforce/agent-tools": ["../../packages/agent-tools/src/index.ts"],
      "@builderforce/agent-tools/knowledge": ["../../packages/agent-tools/src/knowledge/index.ts"],
      "@builderforce/knowledge-browser": ["../../packages/knowledge-browser/src/index.ts"],
      "@builderforce/agent-tools/knowledge-index": ["../../packages/agent-tools/src/knowledge-index.ts"],
      "@builderforce/agent-tools/prefetch": ["../../packages/agent-tools/src/prefetch/index.ts"],
      "@builderforce/prefetch": ["../../packages/prefetch/src/index.ts"],
      "@builderforce/knowledge-client": ["../../packages/knowledge-client/src/index.ts"],
      "@builderforce/knowledge-graph-view": ["../../packages/knowledge-graph-view/src/index.ts"],
      "@builderforce/knowledge-graph-view/testing": ["../../packages/knowledge-graph-view/src/testing.ts"],
      "@builderforce/device-auth": ["../../packages/device-auth/src/index.ts"],
      "@builderforce/kimi-oauth": ["../../packages/kimi-oauth/src/index.ts"],
      "@builderforce/local-first": ["../../packages/local-first/src/index.ts"],
      "@builderforce/local-inference": ["../../packages/local-inference/src/index.ts"],
      "@builderforce/model-catalog": ["../../packages/model-catalog/src/index.ts"],
      "@builderforce/provider-connect": ["../../packages/provider-connect/src/index.ts"],
      "@builderforce/provider-connect/accounts": ["../../packages/provider-connect/src/connectedAccounts.ts"],
      "@builderforce/write-outbox": ["../../packages/write-outbox/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "three": ["./node_modules/@types/three"],
      "@react-three/fiber": ["./node_modules/@react-three/fiber"],
      "@react-three/drei": ["./node_modules/@react-three/drei"],
      "@seanhogg/builderforce-memory/knowledge": ["./node_modules/@seanhogg/builderforce-memory/dist/knowledge/index.d.ts"],
      "@seanhogg/builderforce-memory/ingest": ["./node_modules/@seanhogg/builderforce-memory/dist/ingest/index.d.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
