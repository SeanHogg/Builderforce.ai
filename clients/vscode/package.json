{
  "name": "builderforce-ai",
  "displayName": "BuilderForce.ai",
  "description": "%extension.description%",
  "version": "2026.10.4",
  "publisher": "builderforce",
  "license": "MIT",
  "author": "Sean Hogg",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "coding assistant",
    "builderforce",
    "copilot",
    "local llm",
    "local models",
    "ollama",
    "freetoken",
    "offline"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "homepage": "https://builderforce.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeanHogg/Builderforce.ai.git",
    "directory": "clients/vscode"
  },
  "bugs": {
    "url": "https://github.com/SeanHogg/Builderforce.ai/issues"
  },
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "builderforce",
          "title": "BuilderForce",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "builderforce": [
        {
          "id": "builderforce.welcome",
          "name": "%view.welcome%",
          "when": "!builderforce.signedIn"
        },
        {
          "id": "builderforce.work",
          "name": "%view.work%",
          "when": "builderforce.signedIn"
        },
        {
          "id": "builderforce.inbox",
          "name": "%view.inbox%",
          "when": "builderforce.signedIn"
        },
        {
          "id": "builderforce.changes",
          "name": "%view.changes%"
        },
        {
          "id": "builderforce.health",
          "name": "%view.health%",
          "when": "builderforce.signedIn"
        },
        {
          "id": "builderforce.evermind",
          "type": "webview",
          "name": "%view.evermind%",
          "when": "builderforce.signedIn"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "builderforce.welcome",
        "contents": "%welcome.signIn%"
      }
    ],
    "commands": [
      {
        "command": "builderforce.openCreateCanvas",
        "title": "%command.openCreateCanvas%",
        "icon": "$(layout)"
      },
      {
        "command": "builderforce.openCreationSession",
        "title": "Open Creation Session…",
        "category": "BuilderForce",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "builderforce.scheduleMeeting",
        "title": "%command.scheduleMeeting%",
        "category": "BuilderForce",
        "icon": "$(add)"
      },
      {
        "command": "builderforce.joinMeetingBrowser",
        "title": "%command.joinMeetingBrowser%",
        "category": "BuilderForce",
        "icon": "$(link-external)"
      },
      {
        "command": "builderforce.joinMeetingNative",
        "title": "%command.joinMeetingNative%",
        "category": "BuilderForce",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "builderforce.logMeeting",
        "title": "Log Meeting as Paid Time",
        "category": "BuilderForce",
        "icon": "$(calendar)"
      },
      {
        "command": "builderforce.refreshInsights",
        "title": "%command.refreshInsights%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.refreshEvermind",
        "title": "%command.refreshEvermind%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.signIn",
        "title": "%command.signIn%",
        "icon": "$(sign-in)"
      },
      {
        "command": "builderforce.signOut",
        "title": "%command.signOut%",
        "icon": "$(sign-out)"
      },
      {
        "command": "builderforce.newSession",
        "title": "%command.newSession%",
        "icon": "$(add)"
      },
      {
        "command": "builderforce.openSession",
        "title": "%command.openSession%"
      },
      {
        "command": "builderforce.renameSession",
        "title": "%command.renameSession%",
        "icon": "$(edit)"
      },
      {
        "command": "builderforce.deleteSession",
        "title": "%command.deleteSession%",
        "icon": "$(trash)"
      },
      {
        "command": "builderforce.archiveSession",
        "title": "%command.archiveSession%",
        "icon": "$(archive)"
      },
      {
        "command": "builderforce.unarchiveSession",
        "title": "%command.unarchiveSession%",
        "icon": "$(unarchive)"
      },
      {
        "command": "builderforce.toggleShowArchived",
        "title": "%command.toggleShowArchived%",
        "icon": "$(archive)"
      },
      {
        "command": "builderforce.selectProject",
        "title": "%command.selectProject%",
        "icon": "$(folder)"
      },
      {
        "command": "builderforce.createProject",
        "title": "%command.createProject%",
        "icon": "$(new-folder)"
      },
      {
        "command": "builderforce.createWorkspace",
        "title": "%command.createWorkspace%",
        "icon": "$(organization)"
      },
      {
        "command": "builderforce.registerMcpServer",
        "title": "%command.registerMcpServer%",
        "category": "BuilderForce",
        "icon": "$(plug)"
      },
      {
        "command": "builderforce.manageByoConnections",
        "title": "%command.manageByoConnections%",
        "category": "BuilderForce",
        "icon": "$(key)"
      },
      {
        "command": "builderforce.refreshProjects",
        "title": "%command.refreshProjects%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.hideDoneTasks",
        "title": "%command.hideDoneTasks%",
        "icon": "$(eye)"
      },
      {
        "command": "builderforce.showDoneTasks",
        "title": "%command.showDoneTasks%",
        "icon": "$(eye-closed)"
      },
      {
        "command": "builderforce.projectViewHierarchy",
        "title": "%command.projectViewHierarchy%",
        "icon": "$(list-tree)"
      },
      {
        "command": "builderforce.projectViewFlat",
        "title": "%command.projectViewFlat%",
        "icon": "$(list-flat)"
      },
      {
        "command": "builderforce.projectGroupBy",
        "title": "%command.projectGroupBy%",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "builderforce.projectSortBy",
        "title": "%command.projectSortBy%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "builderforce.projectFilterStatus",
        "title": "%command.projectFilterStatus%",
        "icon": "$(filter)"
      },
      {
        "command": "builderforce.projectFilterAttentionOn",
        "title": "%command.projectFilterAttentionOn%",
        "icon": "$(warning)"
      },
      {
        "command": "builderforce.projectFilterAttentionOff",
        "title": "%command.projectFilterAttentionOff%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "builderforce.projectFilterMineOn",
        "title": "%command.projectFilterMineOn%",
        "icon": "$(account)"
      },
      {
        "command": "builderforce.projectFilterMineOff",
        "title": "%command.projectFilterMineOff%",
        "icon": "$(account)"
      },
      {
        "command": "builderforce.convertTaskType",
        "title": "%command.convertTaskType%",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "builderforce.startTaskSession",
        "title": "%command.startTaskSession%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "builderforce.setTaskStatus",
        "title": "%command.setTaskStatus%",
        "icon": "$(checklist)"
      },
      {
        "command": "builderforce.runTask",
        "title": "%command.runTask%",
        "icon": "$(play)"
      },
      {
        "command": "builderforce.humanRequests",
        "title": "%command.humanRequests%",
        "icon": "$(verified)"
      },
      {
        "command": "builderforce.openProject360",
        "title": "%command.openProject360%",
        "icon": "$(pie-chart)"
      },
      {
        "command": "builderforce.openBoard",
        "title": "%command.openBoard%",
        "icon": "$(layout)"
      },
      {
        "command": "builderforce.openPage",
        "title": "%command.openPage%",
        "icon": "$(browser)"
      },
      {
        "command": "builderforce.diagnose",
        "title": "%command.diagnose%",
        "icon": "$(pulse)"
      },
      {
        "command": "builderforce.rescanCodebase",
        "title": "%command.rescanCodebase%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.pickModel",
        "title": "%command.pickModel%",
        "icon": "$(list-selection)"
      },
      {
        "command": "builderforce.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "builderforce.editorChat",
        "title": "%command.editorChat%",
        "icon": {
          "light": "media/icon.png",
          "dark": "media/icon.png"
        }
      },
      {
        "command": "builderforce.openBrain",
        "title": "%command.openBrain%",
        "icon": "$(sparkle)"
      },
      {
        "command": "builderforce.reviewPullRequests",
        "title": "%command.reviewPullRequests%",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "builderforce.fixErrors",
        "title": "%command.fixErrors%",
        "icon": "$(bug)"
      },
      {
        "command": "builderforce.openPullRequest",
        "title": "%command.openPullRequest%",
        "icon": "$(git-commit)"
      },
      {
        "command": "builderforce.reviewChanges",
        "title": "%command.reviewChanges%",
        "icon": "$(diff)"
      },
      {
        "command": "builderforce.refreshInbox",
        "title": "%command.refreshInbox%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.refreshWork",
        "title": "%command.refreshWork%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.refreshHealth",
        "title": "%command.refreshHealth%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.refreshSessions",
        "title": "%command.refreshSessions%",
        "icon": "$(refresh)"
      },
      {
        "command": "builderforce.refreshDiagnostics",
        "title": "%command.refreshDiagnostics%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.runDiagnostic",
        "title": "%command.runDiagnostic%",
        "icon": "$(play)"
      },
      {
        "command": "builderforce.openDiagnosticReport",
        "title": "%command.openDiagnosticReport%",
        "icon": "$(output)"
      },
      {
        "command": "builderforce.refreshChanges",
        "title": "%command.refreshChanges%",
        "icon": "$(sync)"
      },
      {
        "command": "builderforce.openChange",
        "title": "%command.openChange%",
        "icon": "$(diff)"
      },
      {
        "command": "builderforce.openSourceControl",
        "title": "%command.openSourceControl%",
        "icon": "$(source-control)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "builderforce.editorChat",
          "group": "navigation@-1"
        }
      ],
      "view/title": [
        {
          "command": "builderforce.newSession",
          "when": "view == builderforce.work",
          "group": "navigation@1"
        },
        {
          "command": "builderforce.openBoard",
          "when": "view == builderforce.work",
          "group": "navigation@2"
        },
        {
          "command": "builderforce.refreshWork",
          "when": "view == builderforce.work",
          "group": "navigation@3"
        },
        {
          "command": "builderforce.selectProject",
          "when": "view == builderforce.work",
          "group": "0_project@1"
        },
        {
          "command": "builderforce.createProject",
          "when": "view == builderforce.work",
          "group": "0_project@2"
        },
        {
          "command": "builderforce.createWorkspace",
          "when": "view == builderforce.work",
          "group": "0_project@3"
        },
        {
          "command": "builderforce.openProject360",
          "when": "view == builderforce.work",
          "group": "0_project@4"
        },
        {
          "command": "builderforce.openPage",
          "when": "view == builderforce.work",
          "group": "0_project@5"
        },
        {
          "command": "builderforce.humanRequests",
          "when": "view == builderforce.work",
          "group": "0_project@6"
        },
        {
          "command": "builderforce.projectGroupBy",
          "when": "view == builderforce.work",
          "group": "1_arrange@1"
        },
        {
          "command": "builderforce.projectSortBy",
          "when": "view == builderforce.work",
          "group": "1_arrange@2"
        },
        {
          "command": "builderforce.projectFilterStatus",
          "when": "view == builderforce.work",
          "group": "1_arrange@3"
        },
        {
          "command": "builderforce.projectFilterAttentionOn",
          "when": "view == builderforce.work && !builderforce.projectNeedsAttention",
          "group": "1_arrange@4"
        },
        {
          "command": "builderforce.projectFilterAttentionOff",
          "when": "view == builderforce.work && builderforce.projectNeedsAttention",
          "group": "1_arrange@4"
        },
        {
          "command": "builderforce.projectFilterMineOn",
          "when": "view == builderforce.work && !builderforce.projectAssignedToMe",
          "group": "1_arrange@5"
        },
        {
          "command": "builderforce.projectFilterMineOff",
          "when": "view == builderforce.work && builderforce.projectAssignedToMe",
          "group": "1_arrange@5"
        },
        {
          "command": "builderforce.rescanCodebase",
          "when": "view == builderforce.work",
          "group": "2_workspace@1"
        },
        {
          "command": "builderforce.pickModel",
          "when": "view == builderforce.work",
          "group": "3_account@1"
        },
        {
          "command": "builderforce.signIn",
          "when": "view == builderforce.work",
          "group": "3_account@2"
        },
        {
          "command": "builderforce.signOut",
          "when": "view == builderforce.work",
          "group": "3_account@3"
        },
        {
          "command": "builderforce.openSettings",
          "when": "view == builderforce.work",
          "group": "3_account@4"
        },
        {
          "command": "builderforce.scheduleMeeting",
          "when": "view == builderforce.inbox",
          "group": "navigation@1"
        },
        {
          "command": "builderforce.refreshInbox",
          "when": "view == builderforce.inbox",
          "group": "navigation@2"
        },
        {
          "command": "builderforce.refreshHealth",
          "when": "view == builderforce.health",
          "group": "navigation@1"
        },
        {
          "command": "builderforce.refreshEvermind",
          "when": "view == builderforce.evermind",
          "group": "navigation@1"
        },
        {
          "command": "builderforce.openPullRequest",
          "when": "view == builderforce.changes",
          "group": "navigation@1"
        },
        {
          "command": "builderforce.openSourceControl",
          "when": "view == builderforce.changes",
          "group": "navigation@2"
        },
        {
          "command": "builderforce.refreshChanges",
          "when": "view == builderforce.changes",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "builderforce.newSession",
          "when": "view == builderforce.work && viewItem == bfSection.sessions",
          "group": "inline@1"
        },
        {
          "command": "builderforce.toggleShowArchived",
          "when": "view == builderforce.work && viewItem == bfSection.sessions",
          "group": "inline@2"
        },
        {
          "command": "builderforce.projectFilterStatus",
          "when": "view == builderforce.work && viewItem == bfSection.tasks",
          "group": "inline@1"
        },
        {
          "command": "builderforce.hideDoneTasks",
          "when": "view == builderforce.work && viewItem == bfSection.tasks && !builderforce.hideDoneTasks",
          "group": "inline@2"
        },
        {
          "command": "builderforce.showDoneTasks",
          "when": "view == builderforce.work && viewItem == bfSection.tasks && builderforce.hideDoneTasks",
          "group": "inline@2"
        },
        {
          "command": "builderforce.projectViewHierarchy",
          "when": "view == builderforce.work && viewItem == bfSection.tasks && !builderforce.projectHierarchy",
          "group": "inline@3"
        },
        {
          "command": "builderforce.projectViewFlat",
          "when": "view == builderforce.work && viewItem == bfSection.tasks && builderforce.projectHierarchy",
          "group": "inline@3"
        },
        {
          "command": "builderforce.scheduleMeeting",
          "when": "view == builderforce.inbox && viewItem == bfSection.meetings",
          "group": "inline@1"
        },
        {
          "command": "builderforce.joinMeetingNative",
          "when": "view == builderforce.inbox && viewItem == bfMeeting",
          "group": "inline@1"
        },
        {
          "command": "builderforce.joinMeetingBrowser",
          "when": "view == builderforce.inbox && viewItem == bfMeeting",
          "group": "inline@2"
        },
        {
          "command": "builderforce.renameSession",
          "when": "view == builderforce.work && viewItem == builderforceSession",
          "group": "inline@1"
        },
        {
          "command": "builderforce.deleteSession",
          "when": "view == builderforce.work && viewItem == builderforceSession",
          "group": "inline@2"
        },
        {
          "command": "builderforce.archiveSession",
          "when": "view == builderforce.work && viewItem == builderforceSession",
          "group": "inline@3"
        },
        {
          "command": "builderforce.unarchiveSession",
          "when": "view == builderforce.work && viewItem == builderforceSession",
          "group": "inline@4"
        },
        {
          "command": "builderforce.runTask",
          "when": "view == builderforce.work && viewItem == builderforceTask",
          "group": "inline@1"
        },
        {
          "command": "builderforce.startTaskSession",
          "when": "view == builderforce.work && viewItem == builderforceTask",
          "group": "inline@2"
        },
        {
          "command": "builderforce.setTaskStatus",
          "when": "view == builderforce.work && viewItem == builderforceTask",
          "group": "inline@3"
        },
        {
          "command": "builderforce.convertTaskType",
          "when": "view == builderforce.work && viewItem == builderforceTask",
          "group": "9_modify@1"
        },
        {
          "command": "builderforce.runDiagnostic",
          "when": "view == builderforce.health && viewItem == builderforceDiagnostic",
          "group": "inline@1"
        },
        {
          "command": "builderforce.openDiagnosticReport",
          "when": "view == builderforce.health && viewItem == builderforceDiagnostic",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "builderforce.openSession",
          "when": "false"
        },
        {
          "command": "builderforce.deleteSession",
          "when": "false"
        },
        {
          "command": "builderforce.renameSession",
          "when": "false"
        },
        {
          "command": "builderforce.startTaskSession",
          "when": "false"
        },
        {
          "command": "builderforce.setTaskStatus",
          "when": "false"
        },
        {
          "command": "builderforce.convertTaskType",
          "when": "false"
        },
        {
          "command": "builderforce.runTask",
          "when": "false"
        },
        {
          "command": "builderforce.editorChat",
          "when": "false"
        },
        {
          "command": "builderforce.refreshInbox",
          "when": "false"
        },
        {
          "command": "builderforce.runDiagnostic",
          "when": "false"
        },
        {
          "command": "builderforce.openDiagnosticReport",
          "when": "false"
        },
        {
          "command": "builderforce.openChange",
          "when": "false"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "builderforce.agent",
        "name": "builderforce",
        "fullName": "BuilderForce",
        "description": "%chatParticipant.description%",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "BuilderForce",
      "properties": {
        "builderforce.baseUrl": {
          "type": "string",
          "default": "https://builderforce.ai/gateway",
          "markdownDescription": "%config.baseUrl.desc%"
        },
        "builderforce.webUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.webUrl.desc%"
        },
        "builderforce.defaultModel": {
          "type": "string",
          "default": "",
          "description": "%config.defaultModel.desc%"
        },
        "builderforce.localModels.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.localModels.enabled.desc%"
        },
        "builderforce.localModels.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "markdownDescription": "%config.localModels.ollamaUrl.desc%"
        },
        "builderforce.localModels.freetokenUrl": {
          "type": "string",
          "default": "http://127.0.0.1:1919",
          "markdownDescription": "%config.localModels.freetokenUrl.desc%"
        },
        "builderforce.permissionMode": {
          "type": "string",
          "enum": [
            "ask",
            "acceptEdits"
          ],
          "default": "ask",
          "markdownEnumDescriptions": [
            "%config.permissionMode.ask%",
            "%config.permissionMode.acceptEdits%"
          ],
          "description": "%config.permissionMode.desc%"
        },
        "builderforce.sessionTabs": {
          "type": "string",
          "enum": [
            "reuse",
            "perSession"
          ],
          "default": "reuse",
          "markdownEnumDescriptions": [
            "%config.sessionTabs.reuse%",
            "%config.sessionTabs.perSession%"
          ],
          "description": "%config.sessionTabs.desc%"
        },
        "builderforce.reportErrors": {
          "type": "boolean",
          "default": false,
          "description": "%config.reportErrors.desc%"
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node ../../scripts/ensure-linked-deps.mjs",
    "vscode:prepublish": "node esbuild.mjs --production && tsc -p ./ && pnpm run build:webview",
    "compile": "node esbuild.mjs && tsc -p ./ && pnpm run build:webview",
    "build:webview": "node ../../scripts/ensure-linked-deps.mjs ../../frontend && vite build --config webview/vite.config.ts",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "node ../../scripts/ensure-linked-deps.mjs ../../frontend && vite build --watch --config webview/vite.config.ts",
    "type-check": "tsgo -p ./ && tsgo -p webview/tsconfig.json && tsgo -p harness/tsconfig.json && tsgo -p test-integration/tsconfig.json && tsc -p ./ && tsc -p webview/tsconfig.json && tsc -p harness/tsconfig.json && tsc -p test-integration/tsconfig.json",
    "typecheck": "pnpm run type-check",
    "package": "node vsce-platform.mjs package",
    "publish:marketplace": "node vsce-platform.mjs publish",
    "publish:openvsx": "ovsx publish",
    "typecheck:native": "tsgo -p ./ && tsgo -p webview/tsconfig.json && tsgo -p harness/tsconfig.json && tsgo -p test-integration/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --integration && node out-integration/runTests.cjs",
    "harness": "node esbuild.mjs --harness && node out/harness.cjs",
    "probe": "node esbuild.mjs --harness && node out/harness.cjs probe"
  },
  "devDependencies": {
    "@builderforce/creation-canvas-contract": "link:../../packages/creation-canvas-contract",
    "@huggingface/transformers": "^3.8.1",
    "@seanhogg/builderforce-brain-embedded": "link:../../brain-embedded",
