{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-dom", "node"],
    // The source-only shared packages this project imports. Their `exports` point
    // straight at TypeScript in `src/`, so plain node resolution finds nothing and
    // every consumer has to spell the specifier out. The vite build derives its
    // aliases from `scripts/sourcePackages.mjs` (see `webview/vite.config.ts`);
    // `paths` cannot import a module, so it is written by hand here — which is why
    // it is the copy that drifts. Add an entry the moment a webview source imports
    // a new one, or `tsc --noEmit` fails on a bundle that builds perfectly well.
    //
    // No `baseUrl`: TypeScript 6 removed it (TS5102), and without one a `paths`
    // target resolves relative to THIS file — which is what these already are.
    "paths": {
      "@builderforce/agent-loop": ["../../../packages/agent-loop/src/index.ts"],
      "@builderforce/agent-skills": ["../../../packages/agent-skills/src/index.ts"],
      // The audit view types its code-analysis report off the agent-tools
      // `CodeAnalysisComparison`, so the webview needs the same specifier the
      // root tsconfig maps. Enforced by check:source-package-graph.
      "@builderforce/agent-tools": ["../../../packages/agent-tools/src/index.ts"],
      // The page-engine bridge protocol (`../src/pageEngineBridgeProtocol.ts`) names
      // the local-runtime ids, and the webview reaches it by a relative import.
      "@builderforce/local-inference": ["../../../packages/local-inference/src/index.ts"],
      "@builderforce/model-catalog": ["../../../packages/model-catalog/src/index.ts"],
      // The composer's Connected accounts section lists, tests and reconnects through it.
      "@builderforce/provider-connect": ["../../../packages/provider-connect/src/index.ts"],
      // How a BuilderForce JWT names its workspace is one fact, and the canvas reads
      // it too, so the one copy lives in `frontend/src/lib`. Mapped MODULE BY MODULE
      // rather than as `@/*`: the wildcard would hand this project the frontend's
      // whole import closure to type-check under the editor's stricter options,
      // which is exactly what `exclude` below exists to prevent.
      "@/lib/tokenClaims": ["../../../frontend/src/lib/tokenClaims.ts"],
      // The Knowledge view's packages. Its files (`src/knowledgeGraph`) are checked by the
      // canvas project (excluded below); declared here too so the source-package graph
      // states every edge either project can reach.
      "@builderforce/agent-tools/knowledge": ["../../../packages/agent-tools/src/knowledge/index.ts"],
      "@builderforce/knowledge-client": ["../../../packages/knowledge-client/src/index.ts"],
      "@builderforce/knowledge-browser": ["../../../packages/knowledge-browser/src/index.ts"],
      "@builderforce/agent-tools/knowledge-index": ["../../../packages/agent-tools/src/knowledge-index.ts"],
      "@builderforce/agent-tools/prefetch": ["../../../packages/agent-tools/src/prefetch/index.ts"],
      "@builderforce/prefetch": ["../../../packages/prefetch/src/index.ts"],
      "@builderforce/knowledge-graph-view": ["../../../packages/knowledge-graph-view/src/index.ts"],
      "@builderforce/knowledge-graph-view/testing": ["../../../packages/knowledge-graph-view/src/testing.ts"]
    }
  },
  // The editor's OWN code, checked strictly. Everything that compiles FRONTEND
  // sources — the root screen, the entry, the canvas host port and the Next shims —
  // is the other project's (see tsconfig.canvas.json): those files are written
  // against `frontend/tsconfig.json`'s options, and checking them here reported this
  // project's lint preferences as errors in files this package does not own.
  "include": ["src"],
  "exclude": ["src/canvas", "src/shims", "src/WorkspaceApp.tsx", "src/main.tsx", "src/knowledgeGraph"]
}
