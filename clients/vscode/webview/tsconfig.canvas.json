{
  // The CANVAS project.
  //
  // This bundle compiles the frontend's own sources (see vite.config.ts),
  // so it must typecheck them under the options they are WRITTEN against —
  // `frontend/tsconfig.json`. Checking them under the Brain webview's stricter
  // project reported that project's lint preferences (`noUnusedLocals`) and its
  // narrowed ambient `types` (which hides the WebGPU globals `mamba-engine`
  // relies on) as errors in files this package does not own.
  //
  // Kept separate rather than loosening the Brain project, so the webview's own
  // code stays strictly checked.
  "compilerOptions": {
    // lib/target mirror frontend/tsconfig.json exactly. Not cosmetic: `esnext`
    // is where the WebGPU globals `mamba-engine` uses are declared, and it also
    // supplies the `crypto.randomUUID` signature the canvas is written against.
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    // React types resolve to ONE copy: this package's own `@types/react` and
    // `@types/react-dom`. Ordinary node resolution would not do it — a frontend source
    // (and every library under frontend/node_modules) finds frontend/node_modules'
    // `@types/react`, this package's files find clients/vscode/node_modules', and TS
    // treats the two installs as distinct types even at the same version (ref and
    // SVGProps mismatches at the seam). The bundle runs this package's React 19 too
    // (Vite `dedupe` in vite.config.ts), so types and runtime agree. Never point these
    // at the frontend's copy.
    "paths": {
      "react": ["../node_modules/@types/react/index.d.ts"],
      "react/*": ["../node_modules/@types/react/*"],
      "react-dom": ["../node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["../node_modules/@types/react-dom/*"],
      "@/*": ["../../../frontend/src/*"],
      // Every source-only package the frontend sources reach through `@/*` above,
      // not just the canvas contract. This project compiles FRONTEND files, so it
      // owns their imports too — and `vite.canvas.config.ts` already aliases the
      // whole registry, so a package missing here is a typecheck that disagrees
      // with the bundle it is meant to be checking.
      "@builderforce/creation-canvas-contract": [
        "../../../packages/creation-canvas-contract/src/index.ts"
      ],
      "@builderforce/interaction-contract": [
        "../../../packages/interaction-contract/src/index.ts"
      ],
      "@builderforce/write-outbox": [
        "../../../packages/write-outbox/src/index.ts"
      ],
      "@builderforce/creation-canvas-contract/objectKinds": [
        "../../../packages/creation-canvas-contract/src/objectKinds.ts"
      ],
      "@builderforce/creation-canvas-contract/creativeCapabilities": [
        "../../../packages/creation-canvas-contract/src/creativeCapabilities.ts"
      ],
      "@builderforce/agent-loop": ["../../../packages/agent-loop/src/index.ts"],
      // The canvas runs on the one agent: `@builderforce/agent-run` and everything it imports.
      "@builderforce/agent-run": ["../../../packages/agent-run/src/index.ts"],
      "@builderforce/cost-levers": ["../../../packages/cost-levers/src/index.ts"],
      "@builderforce/difficulty-router": ["../../../packages/difficulty-router/src/index.ts"],
      "@builderforce/learned-routing": ["../../../packages/learned-routing/src/index.ts"],
      "@builderforce/run-guards": ["../../../packages/run-guards/src/index.ts"],
      "@builderforce/tool-output-policy": ["../../../packages/tool-output-policy/src/index.ts"],
      "@builderforce/agent-skills": ["../../../packages/agent-skills/src/index.ts"],
      "@builderforce/ide-file-contract": ["../../../packages/ide-file-contract/src/index.ts"],
      "@builderforce/ide-templates": ["../../../packages/ide-templates/src/index.ts"],
      "@builderforce/canvas-widget-protocol": ["../../../packages/canvas-widget-protocol/src/index.ts"],
      "@builderforce/agent-tools/symbols": ["../../../packages/agent-tools/src/symbols.ts"],
      "@builderforce/agent-tools/knowledge": ["../../../packages/agent-tools/src/knowledge/index.ts"],
      "@builderforce/knowledge-client": ["../../../packages/knowledge-client/src/index.ts"],
      "@builderforce/knowledge-graph-view": ["../../../packages/knowledge-graph-view/src/index.ts"],
      "@builderforce/knowledge-graph-view/testing": ["../../../packages/knowledge-graph-view/src/testing.ts"],
      "@builderforce/knowledge-graph-view/tokens.css": ["../../../packages/knowledge-graph-view/src/tokens.css"],
      "@builderforce/knowledge-browser": ["../../../packages/knowledge-browser/src/index.ts"],
      "@builderforce/agent-tools/knowledge-index": ["../../../packages/agent-tools/src/knowledge-index.ts"],
      "@builderforce/agent-tools/prefetch": ["../../../packages/agent-tools/src/prefetch/index.ts"],
      "@builderforce/prefetch": ["../../../packages/prefetch/src/index.ts"],
      // `@builderforce/knowledge-graph-view` is source-only with these as PEERS and no
      // install of its own (as in frontend/tsconfig.json): three and @react-three/* are the
      // frontend's copies (the bundle resolves them there too — vite.config.ts), memory is
      // this package's. React is the one copy mapped above.
      "three": ["../../../frontend/node_modules/@types/three"],
      "@react-three/fiber": ["../../../frontend/node_modules/@react-three/fiber"],
      "@react-three/drei": ["../../../frontend/node_modules/@react-three/drei"],
      "@seanhogg/builderforce-memory/knowledge": ["../node_modules/@seanhogg/builderforce-memory/dist/knowledge/index.d.ts"],
      "@seanhogg/builderforce-memory/ingest": ["../node_modules/@seanhogg/builderforce-memory/dist/ingest/index.d.ts"],
      "@seanhogg/builderforce-memory/handoff": ["../node_modules/@seanhogg/builderforce-memory/dist/handoff/index.d.ts"],
      "@seanhogg/builderforce-memory/working": ["../node_modules/@seanhogg/builderforce-memory/dist/working/index.d.ts"],
      "@builderforce/model-catalog": ["../../../packages/model-catalog/src/index.ts"],
      "@builderforce/provider-connect": ["../../../packages/provider-connect/src/index.ts"],
      "@builderforce/run-policy": ["../../../packages/run-policy/src/index.ts"],
      "@builderforce/agent-stall": ["../../../packages/agent-stall/src/index.ts"],
      "@builderforce/agent-tools": ["../../../packages/agent-tools/src/index.ts"],
      "@builderforce/local-first": ["../../../packages/local-first/src/index.ts"],
      // `WorkspaceApp.tsx` reaches the page engines (`src/pageEngines.ts`), and through
      // them the page-engine bridge protocol, which names catalog types.
      "@builderforce/local-inference": ["../../../packages/local-inference/src/index.ts"],
      // The three Next couplings, resolved to the shims the bundler also uses —
      // so types and runtime agree on what `useTranslations` / `useRouter` are.
      "next-intl": ["./src/shims/next-intl.ts"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/link": ["./src/shims/next-link.tsx"]
    }
  },
  "include": [
    "src/canvas",
    "src/shims",
    "src/vscodeBridge.ts",
    // Vite's ambient `?url` asset modules (the `bfi` wasm URL in `src/pageEngines.ts`).
    "src/vite-env.d.ts",
    // The root screen and the entry: they mount the frontend's `<CreationCanvas>`
    // and reach it through `@/*`, so they are checked under the options that source
    // is written against — the same reason `src/canvas` is here.
    "src/WorkspaceApp.tsx",
    // The Knowledge view's host side: it mounts the shared `@builderforce/knowledge-graph-view`
    // (frontend-shaped source and peers), so it is checked with the canvas, not the strict project.
    "src/knowledgeGraph",
    "src/main.tsx",
    "vite.config.ts",
    // The frontend's ambient module declarations. Pulled in explicitly because a
    // `.d.ts` nobody imports is never loaded, and the canvas compiles frontend
    // sources that rely on them.
    "../../../frontend/src/types/**/*.d.ts"
  ]
}
