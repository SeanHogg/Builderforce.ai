{
  "//allowJs": "`src/sourcePackages.test.ts` imports the source-package registry (`scripts/sourcePackages.mjs`), which is JSDoc-typed JS. allowJs lets tsc read its inferred types instead of demanding a hand-written .d.mts twin of them.",
  "//memoryPeers": "`@builderforce/knowledge-client` is source-only with `@seanhogg/builderforce-memory` as a PEER and no install of its own (as in frontend/tsconfig.json and clients/chrome/tsconfig.json), so the memory subpaths it reaches are mapped onto THIS package's install. The extension bundle resolves them the same way (`nodePaths` in esbuild.mjs).",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode"],
    "paths": {
      "@builderforce/agent-loop": ["../../packages/agent-loop/src/index.ts"],

      "@builderforce/agent-skills": ["../../packages/agent-skills/src/index.ts"],
      "@builderforce/agent-tools": ["../../packages/agent-tools/src/index.ts"],
      "@builderforce/knowledge-client": ["../../packages/knowledge-client/src/index.ts"],
      "@seanhogg/builderforce-memory/knowledge": ["./node_modules/@seanhogg/builderforce-memory/dist/knowledge/index.d.ts"],
      "@builderforce/agent-tools/*": ["../../packages/agent-tools/src/*"],
      "@builderforce/cost-levers": ["../../packages/cost-levers/src/index.ts"],
      "@builderforce/learned-routing": ["../../packages/learned-routing/src/index.ts"],
      "@builderforce/creation-canvas-contract": ["../../packages/creation-canvas-contract/src/index.ts"],
      "@builderforce/creation-canvas-contract/objectKinds": ["../../packages/creation-canvas-contract/src/objectKinds.ts"],
      "@builderforce/creation-canvas-contract/creativeCapabilities": ["../../packages/creation-canvas-contract/src/creativeCapabilities.ts"],
      "@builderforce/device-auth": ["../../packages/device-auth/src/index.ts"],
      "@builderforce/ide-templates": ["../../packages/ide-templates/src/index.ts"],
      "@builderforce/run-context": ["../../packages/run-context/src/index.ts"],
      "@builderforce/run-guards": ["../../packages/run-guards/src/index.ts"],
      "@builderforce/spend-contract": ["../../packages/spend-contract/src/index.ts"],
      "@builderforce/tool-output-policy": ["../../packages/tool-output-policy/src/index.ts"],
      "@builderforce/kimi-oauth": ["../../packages/kimi-oauth/src/index.ts"],
      "@builderforce/local-inference": ["../../packages/local-inference/src/index.ts"],
      "@builderforce/model-catalog": ["../../packages/model-catalog/src/index.ts"],
      "@builderforce/pipeline-route": ["../../packages/pipeline-route/src/index.ts"],
      "@builderforce/prefetch": ["../../packages/prefetch/src/index.ts"],
      "@builderforce/prefetch/testing": ["../../packages/prefetch/src/testing.ts"],
      "@builderforce/provider-connect": ["../../packages/provider-connect/src/index.ts"],
      "@builderforce/provider-connect/accounts": ["../../packages/provider-connect/src/connectedAccounts.ts"],
      "@builderforce/write-outbox": ["../../packages/write-outbox/src/index.ts"]
    },
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "out", ".vscode-test"]
}
